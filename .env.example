# Copiá este archivo a ".env" para probar en tu máquina local.
# En GitHub Actions estos mismos nombres van como Secrets del repo
# (Settings → Secrets and variables → Actions), NUNCA como archivo en el repo.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_FOOTBALL_KEY=

# ID de Boca Juniors en API-Football. 451 es el valor conocido, pero
# confirmalo corriendo `python scripts/find_team_id.py` antes de confiar
# en el bot. Si te da un ID distinto, sobreescribilo acá.
BOCA_TEAM_ID=451
